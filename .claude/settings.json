{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/hooks/run_validate.sh",
            "shell": "bash",
            "statusMessage": "Validating rule JSON against schema..."
          }
        ]
      }
    ]
  }
}
