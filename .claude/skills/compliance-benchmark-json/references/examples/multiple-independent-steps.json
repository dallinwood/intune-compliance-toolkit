  "description": "Illustrative example: an example remote support service that exposes an interactive session to the device over the network when left enabled.",
  "rationale": "Illustrative example rationale text - not real source prose.",
  "impact": "Illustrative example impact text - not real source prose.",
  "audit": {
    "methods": [
      {
        "method_name": "Graphical Method",
        "type": "manual",
        "description": "Illustrative example: steps to inspect the example remote support service from the settings UI."
      },
      {
        "method_name": "Terminal Method",
        "type": "scripted",
        "description": "Illustrative example: commands to independently verify the example remote support service's configured state, disabled state, and running state.",
        "notes": [
          "Illustrative example note about why three independent checks are used rather than one."
        ],
        "steps": [
          {
            "step_role": "compliance_check",
            "check_command": "example_2_remote_support_status=$(/usr/sbin/examplesetup -getremotesupport | /usr/bin/awk -F': ' '{print $2}')",
            "check_command_verified": true,
            "output_description": "Illustrative example output description for the configured-state check.",
            "check_command_notes": "Illustrative example: parses a colon-delimited status line down to just the on/off token.",
            "output_check": [
              {
                "variable": "example_2_remote_support_status",
                "data_type": "string",
                "operator": "eq",
                "value": "Off",
                "value_source": "rule_defined"
              }
            ]
          },
          {
            "step_role": "compliance_check",
            "check_command": "example_2_remote_support_disabled_count=$(/bin/launchctl print-disabled system | /usr/bin/grep -c '\"com.example.remotesupportd\" => disabled')",
            "check_command_verified": true,
            "output_description": "Illustrative example output description for the disabled-count check.",
            "output_check": [
              {
                "variable": "example_2_remote_support_disabled_count",
                "data_type": "integer",
                "operator": "eq",
                "value": 1,
                "value_source": "rule_defined"
              }
            ]
          },
          {
            "step_role": "compliance_check",
            "check_command": "example_2_remote_support_running_count=$(/bin/launchctl list | /usr/bin/grep -c \"com.example.remotesupportd\")",
            "check_command_verified": true,
            "output_description": "Illustrative example output description for the running-count check.",
            "output_check": [
              {
                "variable": "example_2_remote_support_running_count",
                "data_type": "integer",
                "operator": "eq",
                "value": 0,
                "value_source": "rule_defined"
              }
            ]
          }
        ]
      }
    ]
  },
  "remediation": {
    "methods": [
      {
        "method_name": "Graphical Method",
        "type": "manual_steps",
        "description": "Illustrative example: steps to disable the example remote support service from the settings UI."
      },
      {
        "method_name": "Terminal Method",
        "type": "scripted",
        "description": "Illustrative example: command to disable the example remote support service.",
        "notes": [
          "Illustrative example note about the remediation command also stopping the running service."
        ],
        "steps": [
          {
            "command": "/usr/sbin/examplesetup -setremotesupport off",
