{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias - project references don't inherit compilerOptions, so
       this must be repeated here (not just in the root tsconfig.json) or
       @/ imports type-check fine at the root but fail wherever tsc -b
       actually compiles src/**. No baseUrl: it's deprecated as of this
       TypeScript version - "paths" alone resolves relative to this file
       in bundler moduleResolution mode. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Generator chain still on the pre-v3 types - temporarily excluded until Plan 2 Tasks 4-5 rewrite these.
     Nothing included imports them (GenerateReviewScreen renders a placeholder meanwhile). */
  "exclude": [
    "src/logic/chunking.ts",
    "src/logic/chunking.test.ts",
    "src/logic/rulesJsonGen.ts",
    "src/logic/rulesJsonGen.test.ts",
    "src/logic/bundleFiles.ts",
    "src/logic/bundleFiles.test.ts",
    "src/logic/scriptGen/bash.ts",
    "src/logic/scriptGen/bash.test.ts",
    "src/logic/scriptGen/powershell.ts",
    "src/logic/scriptGen/powershell.test.ts",
    "src/logic/operatorMap.ts",
    "src/logic/operatorMap.test.ts",
    "src/logic/manualAttestationReport.ts",
    "src/logic/manualAttestationReport.test.ts",
    "src/components/generate/BundleGroupCard.tsx",
    "src/components/generate/ManualAttestationReport.tsx"
  ]
}
