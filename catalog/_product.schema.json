{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog product or feature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "vendor", "parent", "requires", "category", "description", "links", "targets"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/product_id" },
    "title": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "parent": { "anyOf": [{ "$ref": "#/$defs/product_id" }, { "type": "null" }] },
    "requires": { "anyOf": [{ "$ref": "#/$defs/requirement" }, { "type": "null" }] },
    "category": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "product_id": { "type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9][a-z0-9-]*$" },
    "requirement": {
      "oneOf": [
        { "$ref": "#/$defs/product_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_of"],
          "properties": { "all_of": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/requirement" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": { "any_of": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/requirement" } } }
        }
      ]
    }
  }
}
