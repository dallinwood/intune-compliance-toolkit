{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog licence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "vendor", "family", "kind", "requires", "description", "links", "includes", "review"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/licence_id" },
    "title": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "family": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["subscription", "add_on"] },
    "requires": { "anyOf": [{ "$ref": "#/$defs/requirement" }, { "type": "null" }] },
    "description": { "type": ["string", "null"] },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target", "availability", "note", "capacity"],
            "properties": {
              "type": { "const": "product" },
              "target": { "$ref": "#/$defs/product_id" },
              "availability": { "$ref": "#/$defs/availability" },
              "note": { "type": ["string", "null"] },
              "capacity": { "type": ["string", "null"], "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target", "availability", "note"],
            "properties": {
              "type": { "const": "licence" },
              "target": { "$ref": "#/$defs/licence_id" },
              "availability": { "$ref": "#/$defs/availability" },
              "note": { "type": ["string", "null"] }
            }
          }
        ]
      }
    },
    "review": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "licence_id": { "type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9][a-z0-9-]*$" },
    "product_id": { "type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9][a-z0-9-]*$" },
    "availability": { "enum": ["included", "add_on"] },
    "requirement": {
      "oneOf": [
        { "$ref": "#/$defs/licence_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_of"],
          "properties": { "all_of": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/requirement" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": { "any_of": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/requirement" } } }
        }
      ]
    }
  }
}
