      "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.ironwood.support\"); (ObjC.unwrap(s.objectForKey(\"allowSiri3489\")) == false && s.objectIsForcedForKey(\"allowSiri3489\")) ? \"PASS\" : \"FAIL\"'"
    }
