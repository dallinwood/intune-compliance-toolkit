  "discussion": "If SSHD is enabled then it _MUST_ be configured to wait only $ODV seconds before timing out logon attempts.\n\nNOTE: On macOS 15.2 and higher the SSH configuration can be reset to the macOS default by running /usr/libexec/reset-ssh-configuration.\n",
  "id": "mscp.os_sshd_login_grace_time_configure",
  "odv": {
    "by_benchmark": {
      "disa_stig": 30
    },
    "datatype": "number",
    "description": "Number of seconds, e.g. 30",
    "recommended": 30,
    "validation": {
      "min": 1
    }
  },
