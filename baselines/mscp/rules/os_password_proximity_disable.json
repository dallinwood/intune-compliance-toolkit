        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowPasswordProximityRequests\")) == false && s.objectIsForcedForKey(\"allowPasswordProximityRequests\")) ? \"PASS\" : \"FAIL\"'"
