      "shell": "/usr/bin/osascript -l JavaScript << EOS\nObjC.unwrap($.NSUserDefaults.alloc.initWithSuiteName('com.apple.systemuiserver')\\\n.objectForKey('mount-controls'))[\"dvdram\"]\nEOS"
    }
