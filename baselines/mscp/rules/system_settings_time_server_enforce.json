      "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.timed\"); (ObjC.unwrap(s.objectForKey(\"TMAutomaticTimeOnlyEnabled\")) == true && s.objectIsForcedForKey(\"TMAutomaticTimeOnlyEnabled\")) ? \"PASS\" : \"FAIL\"'"
