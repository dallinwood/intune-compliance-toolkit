      "result": {
        "type": "string",
        "value": "true"
      },
      "shell": "/usr/bin/osascript -l JavaScript << EOS\nfunction run() {\n  let timeout = ObjC.unwrap($.NSUserDefaults.alloc.initWithSuiteName('com.apple.screensaver')\\\n.objectForKey('idleTime'))\n  if ( timeout <= $ODV ) {\n    return(\"true\")\n  } else {\n    return(\"false\")\n  }\n}\nEOS"
    }
  },
  "discussion": "The screen saver timeout _MUST_ be set to $ODV seconds or a shorter length of time.\n\nThis rule ensures that a full session lock is triggered within no more than $ODV seconds of inactivity.\n",
  "discussion_format": "asciidoc",
  "id": "mscp.system_settings_screensaver_timeout_enforce",
  "odv": {
    "by_benchmark": {
      "cis_lvl1": 900,
      "cis_lvl2": 900,
      "disa_stig": 900,
      "nlmapgov_plus": 300
    },
    "datatype": "number",
    "description": "Number of seconds, e.g. 1200",
    "recommended": 1200,
    "validation": {
      "min": 1
    }
  },
