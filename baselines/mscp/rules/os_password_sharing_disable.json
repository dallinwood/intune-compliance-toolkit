      "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowPasswordSharing\")) == false && s.objectIsForcedForKey(\"allowPasswordSharing\")) ? \"PASS\" : \"FAIL\"'"
