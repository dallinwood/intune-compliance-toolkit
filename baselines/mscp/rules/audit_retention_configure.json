  "check": {
    "by_version": {},
    "default": {
      "additional_info": null,
      "result": {
        "type": "string",
        "value": "$ODV"
      },
      "shell": "/usr/bin/awk -F: '/expire-after/{print $2}' /etc/security/audit_control"
    }
  },
  "discussion": "The audit service _MUST_ be configured to require records be kept for a organizational defined value before deletion, unless the system uses a central audit record storage facility.\n\nWhen \"expire-after\" is set to \"$ODV\", the audit service will not delete audit logs until the log data criteria is met.\n",
  "id": "mscp.audit_retention_configure",
  "odv": {
    "by_benchmark": {
      "cis_lvl1": "60d OR 5G",
      "cis_lvl2": "60d OR 5G",
      "disa_stig": "7d",
      "nlmapgov_base": "180d",
      "nlmapgov_plus": "180d"
    },
    "datatype": "string",
    "description": "Time or disk size, e.g. 60d OR 5G, see the man page for audit_control",
    "recommended": "7d",
    "validation": {
      "regex": "^\\d+[shdyBKMG](\\s(AND|OR)\\s\\d+[shdyBKMG])?$"
    }
  },
