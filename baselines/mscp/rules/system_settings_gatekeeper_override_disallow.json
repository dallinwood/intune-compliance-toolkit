      "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.systempolicy.managed\"); (ObjC.unwrap(s.objectForKey(\"DisableOverride\")) == false && s.objectIsForcedForKey(\"DisableOverride\")) ? \"PASS\" : \"FAIL\"'"
