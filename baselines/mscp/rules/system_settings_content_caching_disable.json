        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowContentCaching\")) == false && s.objectIsForcedForKey(\"allowContentCaching\")) ? \"PASS\" : \"FAIL\"'"
