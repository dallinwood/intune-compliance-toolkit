        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess.new\"); (ObjC.unwrap(s.objectForKey(\"familyControlsEnabled\")) == true && s.objectIsForcedForKey(\"familyControlsEnabled\")) ? \"PASS\" : \"FAIL\"'"
