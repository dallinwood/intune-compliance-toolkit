        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.MCX\"); (ObjC.unwrap(s.objectForKey(\"forceInternetSharingOff\")) == true && s.objectIsForcedForKey(\"forceInternetSharingOff\")) ? \"PASS\" : \"FAIL\"'"
