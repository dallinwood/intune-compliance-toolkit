  "check": {
    "macOS": {
      "by_version": {},
      "default": {
        "additional_info": null,
        "result": {
          "type": "string",
          "value": "pass"
        },
        "shell": "/usr/bin/pwpolicy -getaccountpolicies 2> /dev/null | /usr/bin/tail +2 | /usr/bin/xmllint --xpath '//dict/key[text()=\"policyAttributePasswordHistoryDepth\"]/following-sibling::*[1]/text()' - | /usr/bin/awk '{ if ($1 >= $ODV ) {print \"pass\"} else {print \"fail\"}}' | /usr/bin/uniq"
      },
      "language": "bash"
    }
  },
  "discussion": "The device _MUST_ be configured to enforce a password history of at least $ODV previous passwords when a password is created.\n\nThis rule ensures that users are not allowed to re-use a password that was used in any of the $ODV previous password generations.\n\nLimiting password reuse protects against malicious users attempting to gain access to the system via brute-force hacking methods.\n",
  "discussion_format": "asciidoc",
  "id": "mscp.pwpolicy_history_enforce",
  "odv": {
    "by_benchmark": {
      "cis_lvl1": 24,
      "cis_lvl2": 24
    },
    "datatype": "number",
    "description": "Number of previous passwords, e.g. 5",
    "recommended": 5,
    "validation": {
      "min": 0
    }
  },
