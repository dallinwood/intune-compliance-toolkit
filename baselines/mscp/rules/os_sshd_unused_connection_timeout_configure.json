  },
  "discussion": "If SSHD is enabled it _MUST_ be configured with unused connection timeout set to $ODV.\n\nThis will set the time out when there are no open channels within an session.\n\nNOTE: On macOS 15.2 and higher the SSH configuration can be reset to the macOS default by running /usr/libexec/reset-ssh-configuration.\n",
  "discussion_format": "asciidoc",
  "id": "mscp.os_sshd_unused_connection_timeout_configure",
  "odv": {
    "by_benchmark": {
      "disa_stig": 900
    },
    "datatype": "number",
    "description": "Number of seconds, e.g. 900",
    "recommended": 900,
    "validation": {
      "min": 1
    }
  },
