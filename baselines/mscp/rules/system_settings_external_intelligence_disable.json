      "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowExternalIntelligenceIntegrations\")) == false && s.objectIsForcedForKey(\"allowExternalIntelligenceIntegrations\")) ? \"PASS\" : \"FAIL\"'"
