      "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowCloudDocumentSync\")) == false && s.objectIsForcedForKey(\"allowCloudDocumentSync\")) ? \"PASS\" : \"FAIL\"'"
    }
