      "shell": "/usr/bin/osascript -l JavaScript << EOS\nfunction run() {\n  let timeout = ObjC.unwrap($.NSUserDefaults.alloc.initWithSuiteName('com.apple.applicationaccess')\\\n.objectForKey('enforcedSoftwareUpdateDelay')) || 0\n  if ( timeout <= $ODV ) {\n    return(\"true\")\n  } else {\n    return(\"false\")\n  }\n}\nEOS"
    }
