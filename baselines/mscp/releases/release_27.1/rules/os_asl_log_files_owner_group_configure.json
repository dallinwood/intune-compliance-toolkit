        "shell": "/usr/bin/awk 'FNR==1{b=(FILENAME==\"/etc/asl.conf\")?\"/var/log/\":\"/var/log/module/\" substr(FILENAME,10) \"/\"} $1==\">\"{print (($2 ~ /^\\//)?$2:b $2)}' /etc/asl.conf /etc/asl/* 2>/dev/null | /usr/bin/sort -u | while IFS= read -r p; do [ -f \"$p\" ] && [ ! -L \"$p\" ] && /usr/bin/find \"$p\" \\( ! -user root -o ! -group wheel \\) -print; done | /usr/bin/wc -l | /usr/bin/tr -d ' '"
      },
