        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.loginwindow\"); (ObjC.unwrap(s.objectForKey(\"AdminMayDisableMCX\")) == false && s.objectIsForcedForKey(\"AdminMayDisableMCX\")) ? \"PASS\" : \"FAIL\"'"
