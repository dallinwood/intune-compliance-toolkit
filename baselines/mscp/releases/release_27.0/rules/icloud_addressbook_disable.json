        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowCloudAddressBook\")) == false && s.objectIsForcedForKey(\"allowCloudAddressBook\")) ? \"PASS\" : \"FAIL\"'"
