          "value": "true"
        },
        "shell": "/usr/bin/osascript -l JavaScript << EOS\n$.NSUserDefaults.alloc.initWithSuiteName('com.apple.loginwindow')\\\n.objectForKey('com.apple.login.mcx.DisableAutoLoginClient').js\nEOS"
      },
      "language": "bash"
    }
