  "discussion": "The macOS _MUST_ be configured to disable accounts after $ODV days of inactivity.\n\nThis rule prevents malicious users from making use of unused accounts to gain access to the system while avoiding detection.\n",
  "discussion_format": "asciidoc",
  "id": "mscp.pwpolicy_account_inactivity_enforce",
  "odv": {
    "by_benchmark": {
      "disa_stig": 35
    },
    "datatype": "number",
    "description": "Number of seconds, e.g. 35",
    "recommended": 35,
    "validation": {
      "min": 1
    }
  },
