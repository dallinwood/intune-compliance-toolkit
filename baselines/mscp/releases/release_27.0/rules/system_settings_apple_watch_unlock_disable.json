          "value": "PASS"
        },
        "shell": "/usr/bin/osascript -l JavaScript -e 'var s = $.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\"); (ObjC.unwrap(s.objectForKey(\"allowAutoUnlock\")) == false && s.objectIsForcedForKey(\"allowAutoUnlock\")) ? \"PASS\" : \"FAIL\"'"
      },
      "language": "bash"
    }
