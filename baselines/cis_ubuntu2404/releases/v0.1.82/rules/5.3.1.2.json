  "remediation": {
    "Linux": {
      "payloads": [],
      "steps": [
        {
          "additional_info": "ComplianceAsCode rule `package_pam_modules_installed`",
          "language": "bash",
          "name": "Install pam-modules Package",
          "shell": "# Remediation is applicable only in certain platforms\nif dpkg-query --show --showformat='${db:Status-Status}' 'libpam-runtime' 2>/dev/null | grep -q '^installed$'; then\n\nDEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=60 install -y \"libpam-modules\"\n\nelse\n    >&2 echo 'Remediation is not applicable, nothing was done'\nfi",
