{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library manifest (v6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 6 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "display_name", "release_tag", "commit_sha", "retrieved_date",
          "repository_url", "license", "index_path", "rule_count", "releases"
        ],
        "properties": {
          "name": { "type": "string" },
          "display_name": { "type": "string" },
          "release_tag": { "type": "string" },
          "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])" },
          "retrieved_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])" },
          "repository_url": { "type": "string" },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "rights_holder", "modified"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "rights_holder": { "type": "string" },
              "modified": { "const": true }
            }
          },
          "index_path": {
            "type": "string",
            "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|(?![\\s\\S])))[^\\\\:\\n]+(?![\\s\\S])"
          },
          "rule_count": { "type": "integer", "minimum": 0 },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag", "label", "published_date", "commit_sha", "retrieved_date",
                "importer_format", "index_path", "rule_count"
              ],
              "properties": {
                "tag": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?![\\s\\S])" },
                "label": { "type": "string", "minLength": 1 },
                "published_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])" },
                "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])" },
                "retrieved_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])" },
                "importer_format": { "type": "string", "minLength": 1 },
                "index_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|(?![\\s\\S])))[^\\\\:\\n]+(?![\\s\\S])"
                },
                "rule_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
