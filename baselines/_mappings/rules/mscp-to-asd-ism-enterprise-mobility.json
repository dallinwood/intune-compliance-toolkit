{
  "schema_version": 1,
  "id": "mscp-to-asd-ism-enterprise-mobility",
  "description": "mSCP rules that support ASD ISM controls in the Guidelines for enterprise mobility.",
  "links": [
    {
      "relation": "supports",
      "from": [
        {
          "kind": "rule",
          "id": "mscp.os_messages_app_disable",
          "release": "release_27.0"
        },
        {
          "kind": "rule",
          "id": "mscp.os_messages_app_disable_familycontrols",
          "release": "release_27.0"
        }
      ],
      "to": [
        {
          "kind": "rule",
          "id": "asd_ism.ism-0240",
          "release": "v2026.09.4"
        }
      ],
      "note": "Blocks the Apple Messages app from launching on Mac laptops, so that messaging app cannot be used to send sensitive or classified data; other messaging apps and SMS/MMS are not covered."
    },
    {
      "relation": "supports",
      "from": [
        {
          "kind": "rule",
