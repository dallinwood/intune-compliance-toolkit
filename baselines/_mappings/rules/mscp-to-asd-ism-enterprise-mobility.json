          "kind": "rule",
          "id": "mscp.os_sshd_fips_compliant",
          "release": "release_27.0"
        }
      ],
      "to": [
        {
          "kind": "rule",
          "id": "asd_ism.ism-1085",
          "release": "v2026.09.4"
        }
      ],
