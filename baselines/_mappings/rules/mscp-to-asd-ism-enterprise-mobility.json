          "release": "release_27.0"
        },
        {
          "kind": "rule",
          "id": "mscp.os_sip_enable",
          "release": "release_27.0"
        }
      ],
      "to": [
        {
          "kind": "rule",
          "id": "asd_ism.ism-0864",
          "release": "v2026.09.4"
        }
      ],
      "note": "Mac laptops stop users from overriding Gatekeeper, installing their own configuration profiles, or turning off System Integrity Protection."
    },
