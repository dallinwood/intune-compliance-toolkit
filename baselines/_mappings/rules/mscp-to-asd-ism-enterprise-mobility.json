      ],
      "to": [
        {
          "kind": "rule",
          "id": "asd_ism.ism-0869",
          "release": "v2026.09.4"
        }
      ],
      "note": "Requires internal APFS storage to be encrypted on Mac laptops (mobile devices) using ASD-approved cryptography; removable media is not covered."
    },
    {
      "relation": "supports",
      "from": [
        {
          "kind": "rule",
