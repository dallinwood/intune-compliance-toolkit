      ],
      "to": [
        {
          "kind": "rule",
          "id": "asd_ism.ism-0869",
          "release": "v2026.09.4"
        }
      ],
      "note": "Turns on FileVault to encrypt internal storage on Mac laptops (mobile devices) with ASD-approved cryptography; removable media is not covered."
    },
