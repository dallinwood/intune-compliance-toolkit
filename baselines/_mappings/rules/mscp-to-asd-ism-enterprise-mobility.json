          "kind": "rule",
          "id": "asd_ism.ism-0864",
          "release": "v2026.09.4"
        }
      ],
      "note": "Mac laptops are protected by a recovery lock (Apple silicon) or firmware password (Intel) so users cannot change startup security."
    },
    {
      "relation": "supports",
      "from": [
        {
          "kind": "rule",
