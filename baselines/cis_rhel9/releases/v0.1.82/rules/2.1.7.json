  "remediation": {
    "Linux": {
      "payloads": [],
      "steps": [
        {
          "additional_info": "ComplianceAsCode rule `package_vsftpd_removed`",
          "language": "bash",
          "name": "Uninstall vsftpd Package",
          "shell": "# CAUTION: This remediation script will remove vsftpd\n# from the system, and may remove any packages\n# that depend on vsftpd. Execute this\n# remediation AFTER testing on a non-production\n# system!\n\n\nif rpm -q --quiet \"vsftpd\" ; then\ndnf remove -y --noautoremove \"vsftpd\"\nfi",
          "versions": null
        }
      ]
    }
