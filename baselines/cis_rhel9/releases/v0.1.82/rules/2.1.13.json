    }
  },
  "remediation": {
    "Linux": {
      "payloads": [],
      "steps": [
        {
          "additional_info": "ComplianceAsCode rule `package_rsync_removed`",
          "language": "bash",
          "name": "Uninstall rsync Package",
          "shell": "# CAUTION: This remediation script will remove rsync-daemon\n# from the system, and may remove any packages\n# that depend on rsync-daemon. Execute this\n# remediation AFTER testing on a non-production\n# system!\n\n\nif rpm -q --quiet \"rsync-daemon\" ; then\ndnf remove -y --noautoremove \"rsync-daemon\"\nfi",
          "versions": null
        }
      ]
    }
