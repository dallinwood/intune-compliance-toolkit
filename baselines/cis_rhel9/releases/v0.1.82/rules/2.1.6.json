  "remediation": {
    "Linux": {
      "payloads": [],
      "steps": [
        {
          "additional_info": "ComplianceAsCode rule `package_samba_removed`",
          "language": "bash",
          "name": "Uninstall Samba Package",
          "shell": "# CAUTION: This remediation script will remove samba\n# from the system, and may remove any packages\n# that depend on samba. Execute this\n# remediation AFTER testing on a non-production\n# system!\n\n\nif rpm -q --quiet \"samba\" ; then\ndnf remove -y --noautoremove \"samba\"\nfi",
          "versions": null
        }
      ]
    }
