  "remediation": {
    "Linux": {
      "payloads": [],
      "steps": [
        {
          "additional_info": "ComplianceAsCode rule `package_sudo_installed`",
          "language": "bash",
          "name": "Install sudo Package",
          "shell": "# Remediation is applicable only in certain platforms\nif rpm --quiet -q kernel-core; then\n\nif ! rpm -q --quiet \"sudo\" ; then\n    dnf install -y \"sudo\"\nfi\n\nelse\n    >&2 echo 'Remediation is not applicable, nothing was done'\nfi",
