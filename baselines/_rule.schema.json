{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized rule (v7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "discussion", "discussion_format", "section_path",
    "source", "assessment", "architecture", "applicability", "tags", "references",
    "check", "odvs", "remediation"
  ],
  "properties": {
    "schema_version": { "const": 7 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*(?![\\s\\S])" },
    "title": { "type": "string" },
    "discussion": { "type": "string" },
    "discussion_format": { "enum": ["asciidoc", "markdown"] },
    "section_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^\\n]+(?![\\s\\S])" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "release_tag", "commit_sha", "upstream_rule_id",
        "upstream_path", "upstream_revision", "upstream_updated", "upstream_url", "license"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+(?![\\s\\S])" },
        "release_tag": { "type": "string" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])" },
        "upstream_rule_id": { "type": "string" },
        "upstream_path": { "type": "string" },
        "upstream_revision": { "type": ["string", "null"] },
        "upstream_updated": { "type": ["string", "null"] },
        "upstream_url": { "type": "string" },
        "license": { "$ref": "#/$defs/license" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "manual_reason"],
      "properties": {
        "status": { "enum": ["automated", "manual"] },
        "manual_reason": {
          "enum": ["manual", "inherent", "permanent", "n_a", "supplemental", "no_check", "openscap", null]
        }
      },
      "if": { "properties": { "status": { "const": "automated" } } },
      "then": { "properties": { "manual_reason": { "type": "null" } } },
      "else": { "properties": { "manual_reason": { "type": "string" } } }
    },
    "architecture": { "enum": ["arm64", "i386", null] },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "version", "benchmarks"],
        "properties": {
          "target": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"], "pattern": "^\\S+(?![\\s\\S])" },
          "benchmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "severity"],
              "properties": {
                "name": { "type": "string" },
                "severity": { "type": ["string", "null"] }
              }
            }
          }
        },
        "if": { "properties": { "version": { "type": "string" } }, "required": ["version"] },
        "then": { "properties": { "target": { "type": "string" } } }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "object" },
    "check": {
      "type": ["object", "null"],
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/target_name" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target_check" } }
    },
    "odvs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "datatype", "description", "validation", "recommended", "by_benchmark", "quoting"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])" },
          "datatype": { "enum": ["number", "string", "enum", "regex"] },
          "description": { "type": "string" },
          "validation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "regex": { "type": "string" },
                  "enumValues": { "type": "array", "items": { "type": "string" } }
                }
              }
            ]
          },
          "recommended": { "type": ["integer", "string"] },
          "by_benchmark": {
            "type": "object",
            "additionalProperties": { "type": ["integer", "string"] }
          },
          "quoting": { "enum": ["unquoted", "single", "double"] }
        }
      }
    },
    "remediation": {
      "type": ["object", "null"],
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/target_name" },
      "additionalProperties": { "$ref": "#/$defs/target_remediation" }
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "rights_holder", "modified"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "rights_holder": { "type": "string" },
        "modified": { "const": true }
      }
    },
    "check_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "additional_info"],
      "oneOf": [
        { "required": ["shell"], "not": { "anyOf": [{ "required": ["shell_file"] }, { "required": ["registry"] }] } },
        { "required": ["shell_file"], "not": { "anyOf": [{ "required": ["shell"] }, { "required": ["registry"] }] } },
        { "required": ["registry"], "not": { "anyOf": [{ "required": ["shell"] }, { "required": ["shell_file"] }] } }
      ],
      "properties": {
        "shell": { "type": ["string", "null"] },
        "shell_file": { "$ref": "#/$defs/script_file" },
        "registry": { "$ref": "#/$defs/registry_settings" },
        "additional_info": { "type": ["string", "null"] },
        "result": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["integer", "string", "base64"] },
            "value": { "type": ["integer", "string"] }
          },
          "if": { "properties": { "type": { "const": "integer" } } },
          "then": {
            "properties": {
              "value": { "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^\\$ODV_[a-z][a-z0-9_]*(?![\\s\\S])" }] }
            }
          },
          "else": {
            "properties": { "value": { "type": "string" } }
          }
        }
      }
    },
    "script_file": {
      "type": "string",
      "pattern": "^baselines/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(?:ps1|sh|py)(?![\\s\\S])"
    },
    "payload_file": {
      "type": "string",
      "pattern": "^baselines/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(?:mobileconfig|plist|json|xml|reg|admx|adml|pol|intunewin)(?![\\s\\S])"
    },
    "target_name": { "type": "string", "pattern": "^[^\\n]+(?![\\s\\S])" },
    "version": { "type": "string", "pattern": "^\\S+(?![\\s\\S])" },
    "versions": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      ]
    },
    "language": { "enum": ["bash", "powershell", "zsh", "python", "instructions", "registry", "ansible", "goss"] },
    "registry_settings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/registry_setting" } },
    "registry_setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hive", "path", "value_name", "type", "data", "state"],
      "properties": {
        "hive": { "enum": ["HKLM", "HKCU", "HKU", "HKCR"] },
        "path": { "type": "string", "pattern": "^[^\\\\\\n](?:[^\\n]*[^\\\\\\n])?(?![\\s\\S])" },
        "value_name": { "type": "string" },
        "type": { "enum": ["REG_DWORD", "REG_QWORD", "REG_SZ", "REG_EXPAND_SZ", "REG_MULTI_SZ", "REG_BINARY", null] },
        "data": {},
        "state": { "enum": ["present", "absent"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "absent" } }, "required": ["state"] },
          "then": { "properties": { "type": { "type": "null" }, "data": { "type": "null" } } },
          "else": {
            "properties": { "type": { "type": "string" } },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "REG_DWORD" } }, "required": ["type"] },
                "then": { "properties": { "data": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 4294967295 }, { "$ref": "#/$defs/odv_reference" }] } } }
              },
              {
                "if": { "properties": { "type": { "const": "REG_QWORD" } }, "required": ["type"] },
                "then": { "properties": { "data": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }, { "$ref": "#/$defs/odv_reference" }] } } }
              },
              {
                "if": { "properties": { "type": { "enum": ["REG_SZ", "REG_EXPAND_SZ"] } }, "required": ["type"] },
                "then": { "properties": { "data": { "type": "string" } } }
              },
              {
                "if": { "properties": { "type": { "const": "REG_MULTI_SZ" } }, "required": ["type"] },
                "then": { "properties": { "data": { "type": "array", "items": { "type": "string", "not": { "pattern": "^\\$ODV" } } } } }
              },
              {
                "if": { "properties": { "type": { "const": "REG_BINARY" } }, "required": ["type"] },
                "then": { "properties": { "data": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{2})*(?![\\s\\S])" } } }
              }
            ]
          }
        }
      ]
    },
    "odv_reference": { "type": "string", "pattern": "^\\$ODV_[a-z][a-z0-9_]*(?![\\s\\S])" },
    "target_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "default", "by_version"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "language": { "$ref": "#/$defs/language" },
        "default": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/check_entry" }]
        },
        "by_version": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/version" },
          "additionalProperties": { "$ref": "#/$defs/check_entry" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "language": { "const": "registry" } }, "required": ["language"] },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/registry_check_entry" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/registry_check_entry" } }
            }
          },
          "else": {
            "properties": {
              "default": { "$ref": "#/$defs/no_registry_body" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/no_registry_body" } }
            }
          }
        },
        {
          "if": { "properties": { "language": { "enum": ["ansible", "goss"] } }, "required": ["language"] },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/display_text_body" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/display_text_body" } }
            }
          }
        },
        {
          "if": { "properties": { "language": { "const": "powershell" } }, "required": ["language"] },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/shell_file_ps1" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/shell_file_ps1" } }
            }
          }
        },
        {
          "if": { "properties": { "language": { "enum": ["bash", "zsh"] } }, "required": ["language"] },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/shell_file_sh" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/shell_file_sh" } }
            }
          }
        },
        {
          "if": { "properties": { "language": { "const": "python" } }, "required": ["language"] },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/shell_file_py" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/shell_file_py" } }
            }
          }
        },
        {
          "if": { "properties": { "language": { "const": "instructions" } }, "required": ["language"] },
          "then": {
            "properties": {
              "default": { "$ref": "#/$defs/instructions_check_entry" },
              "by_version": { "additionalProperties": { "$ref": "#/$defs/instructions_check_entry" } }
            }
          }
        }
      ]
    },
    "shell_file_ps1": { "properties": { "shell_file": { "pattern": "\\.ps1(?![\\s\\S])" } } },
    "shell_file_sh": { "properties": { "shell_file": { "pattern": "\\.sh(?![\\s\\S])" } } },
    "instructions_check_entry": {
      "required": ["shell", "result"],
      "properties": { "shell": { "type": "null" }, "result": { "type": "null" } }
    },
    "registry_body": { "required": ["registry"] },
    "registry_check_entry": { "required": ["registry", "result"], "properties": { "result": { "type": "null" } } },
    "no_registry_body": { "not": { "type": "object", "required": ["registry"] } },
    "display_text_body": { "required": ["shell"], "properties": { "shell": { "type": "string" } } },
    "instructions_step": {
      "required": ["shell"],
      "properties": { "shell": { "type": "null" } }
    },
    "shell_file_py": { "properties": { "shell_file": { "pattern": "\\.py(?![\\s\\S])" } } },
    "target_remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "payloads"],
      "properties": {
        "steps": { "type": "array", "items": { "$ref": "#/$defs/remediation_step" } },
        "payloads": { "type": "array", "items": { "$ref": "#/$defs/remediation_payload" } }
      }
    },
    "remediation_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "additional_info", "versions"],
      "oneOf": [
        { "required": ["shell"], "not": { "anyOf": [{ "required": ["shell_file"] }, { "required": ["registry"] }] } },
        { "required": ["shell_file"], "not": { "anyOf": [{ "required": ["shell"] }, { "required": ["registry"] }] } },
        { "required": ["registry"], "not": { "anyOf": [{ "required": ["shell"] }, { "required": ["shell_file"] }] } }
      ],
      "properties": {
        "name": { "type": ["string", "null"] },
        "language": { "$ref": "#/$defs/language" },
        "shell": { "type": ["string", "null"] },
        "shell_file": { "$ref": "#/$defs/script_file" },
        "registry": { "$ref": "#/$defs/registry_settings" },
        "additional_info": { "type": ["string", "null"] },
        "versions": { "$ref": "#/$defs/versions" }
      },
      "allOf": [
        {
          "if": { "properties": { "language": { "const": "registry" } }, "required": ["language"] },
          "then": { "$ref": "#/$defs/registry_body" },
          "else": { "$ref": "#/$defs/no_registry_body" }
        },
        {
          "if": { "properties": { "language": { "enum": ["ansible", "goss"] } }, "required": ["language"] },
          "then": { "$ref": "#/$defs/display_text_body" }
        },
        {
          "if": { "properties": { "language": { "const": "powershell" } }, "required": ["language"] },
          "then": { "$ref": "#/$defs/shell_file_ps1" }
        },
        {
          "if": { "properties": { "language": { "enum": ["bash", "zsh"] } }, "required": ["language"] },
          "then": { "$ref": "#/$defs/shell_file_sh" }
        },
        {
          "if": { "properties": { "language": { "const": "python" } }, "required": ["language"] },
          "then": { "$ref": "#/$defs/shell_file_py" }
        },
        {
          "if": { "properties": { "language": { "const": "instructions" } }, "required": ["language"] },
          "then": { "$ref": "#/$defs/instructions_step" }
        }
      ]
    },
    "remediation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "versions"],
      "oneOf": [
        { "required": ["data"], "not": { "required": ["data_file"] } },
        { "required": ["data_file"], "not": { "required": ["data"] } }
      ],
      "properties": {
        "kind": { "type": "string", "pattern": "^[^\\n]+(?![\\s\\S])" },
        "versions": { "$ref": "#/$defs/versions" },
        "data": { "type": ["object", "array"] },
        "data_file": { "$ref": "#/$defs/payload_file" }
      }
    }
  }
}
