{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized rule (v5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "discussion", "discussion_format", "section_path",
    "source", "assessment", "architecture", "applicability", "tags", "references",
    "check", "odv", "remediation"
  ],
  "properties": {
    "schema_version": { "const": 5 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_-]+(?![\\s\\S])" },
    "title": { "type": "string" },
    "discussion": { "type": "string" },
    "discussion_format": { "enum": ["asciidoc", "markdown"] },
    "section_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^\\n]+(?![\\s\\S])" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "release_tag", "commit_sha", "upstream_rule_id",
        "upstream_path", "upstream_revision", "upstream_updated", "upstream_url", "license"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+(?![\\s\\S])" },
        "release_tag": { "type": "string" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])" },
        "upstream_rule_id": { "type": "string" },
        "upstream_path": { "type": "string" },
        "upstream_revision": { "type": ["string", "null"] },
        "upstream_updated": { "type": ["string", "null"] },
        "upstream_url": { "type": "string" },
        "license": { "$ref": "#/$defs/license" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "manual_reason"],
      "properties": {
        "status": { "enum": ["automated", "manual"] },
        "manual_reason": {
          "enum": ["manual", "inherent", "permanent", "n_a", "supplemental", "no_check", null]
        }
      },
      "if": { "properties": { "status": { "const": "automated" } } },
      "then": { "properties": { "manual_reason": { "type": "null" } } },
      "else": { "properties": { "manual_reason": { "type": "string" } } }
    },
    "architecture": { "enum": ["arm64", "i386", null] },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "version", "benchmarks"],
        "properties": {
          "target": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"], "pattern": "^\\S+(?![\\s\\S])" },
          "benchmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "severity"],
              "properties": {
                "name": { "type": "string" },
                "severity": { "type": ["string", "null"] }
              }
            }
          }
        },
        "if": { "properties": { "version": { "type": "string" } }, "required": ["version"] },
        "then": { "properties": { "target": { "type": "string" } } }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "object" },
    "check": {
      "type": ["object", "null"],
      "propertyNames": { "$ref": "#/$defs/target_name" },
      "additionalProperties": { "$ref": "#/$defs/target_check" }
    },
    "odv": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["datatype", "description", "validation", "recommended", "by_benchmark"],
          "properties": {
            "datatype": { "enum": ["number", "string", "enum", "regex"] },
            "description": { "type": "string" },
            "validation": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "regex": { "type": "string" },
                    "enumValues": { "type": "array", "items": { "type": "string" } }
                  }
                }
              ]
            },
            "recommended": { "type": ["integer", "string"] },
            "by_benchmark": {
              "type": "object",
              "additionalProperties": { "type": ["integer", "string"] }
            }
          }
        }
      ]
    },
    "remediation": {
      "type": ["object", "null"],
      "propertyNames": { "$ref": "#/$defs/target_name" },
      "additionalProperties": { "$ref": "#/$defs/target_remediation" }
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "rights_holder", "modified"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "rights_holder": { "type": "string" },
        "modified": { "const": true }
      }
    },
    "check_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "result", "additional_info"],
      "properties": {
        "shell": { "type": ["string", "null"] },
        "additional_info": { "type": ["string", "null"] },
        "result": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["integer", "string", "base64"] },
            "value": { "type": ["integer", "string"] }
          },
          "if": { "properties": { "type": { "const": "integer" } } },
          "then": {
            "properties": {
              "value": { "oneOf": [{ "type": "integer" }, { "const": "$ODV" }] }
            }
          },
          "else": {
            "properties": { "value": { "type": "string" } }
          }
        }
      }
    },
    "target_name": { "type": "string", "pattern": "^[^\\n]+(?![\\s\\S])" },
    "version": { "type": "string", "pattern": "^\\S+(?![\\s\\S])" },
    "versions": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      ]
    },
    "language": { "enum": ["bash", "powershell", "zsh", "python"] },
    "target_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "default", "by_version"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "default": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/check_entry" }]
        },
        "by_version": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/version" },
          "additionalProperties": { "$ref": "#/$defs/check_entry" }
        }
      }
    },
    "target_remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "payloads"],
      "properties": {
        "steps": { "type": "array", "items": { "$ref": "#/$defs/remediation_step" } },
        "payloads": { "type": "array", "items": { "$ref": "#/$defs/remediation_payload" } }
      }
    },
    "remediation_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "shell", "additional_info", "versions"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "language": { "$ref": "#/$defs/language" },
        "shell": { "type": ["string", "null"] },
        "additional_info": { "type": ["string", "null"] },
        "versions": { "$ref": "#/$defs/versions" }
      }
    },
    "remediation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "versions", "data"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[^\\n]+(?![\\s\\S])" },
        "versions": { "$ref": "#/$defs/versions" },
        "data": { "type": ["object", "array"] }
      }
    }
  }
}
