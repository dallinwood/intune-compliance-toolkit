{
  "description": "Shared overlay merge cases, run by tests/test_overlays.py and webui/src/logic/overlays.test.ts so the Python and TypeScript merges cannot drift. A merge case applies `fields` to `rule` (only `known_fields` when given) and expects `expected` or, with `error: true`, a rejected overlay. An index case applies `fields` to the index `entry` and recomputes `section` and `has_odv`.",
  "merge_cases": [
    {
      "name": "empty fields leave the rule unchanged",
      "rule": { "id": "asd_ism.ism-1622", "title": "Upstream title", "tags": ["a"] },
      "fields": {},
      "expected": { "id": "asd_ism.ism-1622", "title": "Upstream title", "tags": ["a"] }
    },
    {
      "name": "a list appends to the upstream list",
      "rule": { "id": "x.rule", "tags": ["a", "b"] },
      "fields": { "tags": ["c"] },
      "expected": { "id": "x.rule", "tags": ["a", "b", "c"] }
    },
    {
      "name": "a list onto an absent field becomes the list",
      "rule": { "id": "x.rule" },
      "fields": { "tags": ["c"] },
      "expected": { "id": "x.rule", "tags": ["c"] }
    },
    {
      "name": "append does not de-duplicate",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": ["a", "a"] },
      "expected": { "id": "x.rule", "tags": ["a", "a", "a"] }
    },
    {
      "name": "appended list entries are taken literally, wrappers included",
      "rule": { "id": "x.rule", "applicability": [] },
      "fields": { "applicability": [{ "$replace": 1 }] },
      "expected": { "id": "x.rule", "applicability": [{ "$replace": 1 }] }
    },
    {
      "name": "a string replaces a string",
      "rule": { "id": "x.rule", "title": "Upstream title" },
      "fields": { "title": "Custom title" },
      "expected": { "id": "x.rule", "title": "Custom title" }
    },
    {
      "name": "a string onto an absent field sets it",
      "rule": { "id": "x.rule" },
      "fields": { "discussion": "Added." },
      "expected": { "id": "x.rule", "discussion": "Added." }
    },
    {
      "name": "a number replaces a string",
      "rule": { "id": "x.rule", "title": "Upstream title" },
      "fields": { "title": 3 },
      "expected": { "id": "x.rule", "title": 3 }
    },
    {
      "name": "a boolean replaces an object",
      "rule": { "id": "x.rule", "assessment": { "status": "manual", "manual_reason": "no_check" } },
      "fields": { "assessment": false },
      "expected": { "id": "x.rule", "assessment": false }
    },
    {
      "name": "a string replaces a list",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": "a" },
      "expected": { "id": "x.rule", "tags": "a" }
    },
    {
      "name": "null replaces an object",
      "rule": { "id": "x.rule", "check": { "default": null, "by_version": {} } },
      "fields": { "check": null },
      "expected": { "id": "x.rule", "check": null }
    },
    {
      "name": "null replaces a scalar",
      "rule": { "id": "x.rule", "architecture": "arm64" },
      "fields": { "architecture": null },
      "expected": { "id": "x.rule", "architecture": null }
    },
    {
      "name": "an object merges key by key, recursively, by the same rules",
      "rule": {
        "id": "x.rule",
        "references": { "nist": { "800-53r5": ["AC-1"] }, "cis": { "benchmark": ["1.1"] } }
      },
      "fields": {
        "references": { "nist": { "800-53r5": ["AC-2"], "cce": ["CCE-1"] }, "microsoft": ["https://learn.microsoft.com/a"] }
      },
      "expected": {
        "id": "x.rule",
        "references": {
          "nist": { "800-53r5": ["AC-1", "AC-2"], "cce": ["CCE-1"] },
          "cis": { "benchmark": ["1.1"] },
          "microsoft": ["https://learn.microsoft.com/a"]
        }
      }
    },
    {
      "name": "nested scalars inside a merged object replace",
      "rule": { "id": "x.rule", "assessment": { "status": "manual", "manual_reason": "no_check" } },
      "fields": { "assessment": { "status": "automated", "manual_reason": null } },
      "expected": { "id": "x.rule", "assessment": { "status": "automated", "manual_reason": null } }
    },
    {
      "name": "an object onto an absent field merges onto an empty object",
      "rule": { "id": "x.rule" },
      "fields": { "references": { "microsoft": ["https://learn.microsoft.com/a"], "nested": { "deeper": "value" } } },
      "expected": { "id": "x.rule", "references": { "microsoft": ["https://learn.microsoft.com/a"], "nested": { "deeper": "value" } } }
    },
    {
      "name": "an empty object leaves the upstream object unchanged",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"] } },
      "fields": { "references": {} },
      "expected": { "id": "x.rule", "references": { "nist": ["AC-1"] } }
    },
    {
      "name": "$replace replaces a list",
      "rule": { "id": "x.rule", "tags": ["a", "b"] },
      "fields": { "tags": { "$replace": ["z"] } },
      "expected": { "id": "x.rule", "tags": ["z"] }
    },
    {
      "name": "$replace replaces an object instead of merging",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"] } },
      "fields": { "references": { "$replace": { "microsoft": ["https://learn.microsoft.com/a"] } } },
      "expected": { "id": "x.rule", "references": { "microsoft": ["https://learn.microsoft.com/a"] } }
    },
    {
      "name": "$replace puts an object where upstream has null",
      "rule": { "id": "asd_ism.ism-1622", "check": null },
      "fields": {
        "check": { "$replace": { "default": { "shell": "echo check", "result": null, "additional_info": null }, "by_version": {} } }
      },
      "expected": {
        "id": "asd_ism.ism-1622",
        "check": { "default": { "shell": "echo check", "result": null, "additional_info": null }, "by_version": {} }
      }
    },
    {
      "name": "$replace replaces a string",
      "rule": { "id": "x.rule", "discussion": "Upstream." },
      "fields": { "discussion": { "$replace": "Custom." } },
      "expected": { "id": "x.rule", "discussion": "Custom." }
    },
    {
      "name": "$replace onto an absent field sets it",
      "rule": { "id": "x.rule" },
      "fields": { "odv": { "$replace": null } },
      "expected": { "id": "x.rule", "odv": null }
    },
    {
      "name": "$replace takes its value literally, wrapper-like keys included",
      "rule": { "id": "x.rule", "references": {} },
      "fields": { "references": { "$replace": { "$append": [1] } } },
      "expected": { "id": "x.rule", "references": { "$append": [1] } }
    },
    {
      "name": "$append appends explicitly",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "$append": ["b", "c"] } },
      "expected": { "id": "x.rule", "tags": ["a", "b", "c"] }
    },
    {
      "name": "$append onto an absent field becomes the list",
      "rule": { "id": "x.rule" },
      "fields": { "tags": { "$append": ["b"] } },
      "expected": { "id": "x.rule", "tags": ["b"] }
    },
    {
      "name": "$merge merges explicitly",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"] } },
      "fields": { "references": { "$merge": { "nist": ["AC-2"], "cis": ["1.1"] } } },
      "expected": { "id": "x.rule", "references": { "nist": ["AC-1", "AC-2"], "cis": ["1.1"] } }
    },
    {
      "name": "$merge onto an absent field merges onto an empty object",
      "rule": { "id": "x.rule" },
      "fields": { "references": { "$merge": { "cis": ["1.1"] } } },
      "expected": { "id": "x.rule", "references": { "cis": ["1.1"] } }
    },
    {
      "name": "wrappers work nested inside a merged object",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"], "cis": ["1.1"] } },
      "fields": { "references": { "nist": { "$replace": ["AC-9"] }, "cis": { "$append": ["1.2"] } } },
      "expected": { "id": "x.rule", "references": { "nist": ["AC-9"], "cis": ["1.1", "1.2"] } }
    },
    {
      "name": "fields outside known_fields are ignored",
      "rule": { "id": "x.rule", "title": "Upstream title", "tags": [] },
      "fields": { "title": "Custom title", "discussion": "Not an index field.", "not_a_field": 1 },
      "known_fields": ["title", "tags"],
      "expected": { "id": "x.rule", "title": "Custom title", "tags": [] }
    },
    {
      "name": "a wrapper with two wrapper keys is invalid",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "$replace": ["b"], "$append": ["c"] } },
      "error": true
    },
    {
      "name": "a wrapper key beside a plain key is invalid",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "$replace": ["b"], "other": 1 } },
      "error": true
    },
    {
      "name": "an unknown $ key is invalid",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "$prepend": ["b"] } },
      "error": true
    },
    {
      "name": "an unknown $ key nested in a plain object is invalid",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"] } },
      "fields": { "references": { "nist": { "$bogus": ["AC-2"] } } },
      "error": true
    },
    {
      "name": "a $ key inside a $merge value is invalid",
      "rule": { "id": "x.rule", "references": {} },
      "fields": { "references": { "$merge": { "$replace": {} } } },
      "error": true
    },
    {
      "name": "$append with a non-list value is invalid",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "$append": "b" } },
      "error": true
    },
    {
      "name": "$merge with a non-object value is invalid",
      "rule": { "id": "x.rule", "references": {} },
      "fields": { "references": { "$merge": ["a"] } },
      "error": true
    },
    {
      "name": "$append onto a string is a type mismatch",
      "rule": { "id": "x.rule", "title": "Upstream title" },
      "fields": { "title": { "$append": ["more"] } },
      "error": true
    },
    {
      "name": "$append onto null appends as onto an absent field",
      "rule": { "id": "x.rule", "tags": null },
      "fields": { "tags": { "$append": ["more"] } },
      "expected": { "id": "x.rule", "tags": ["more"] }
    },
    {
      "name": "a list onto null appends as onto an absent field",
      "rule": { "id": "x.rule", "tags": null },
      "fields": { "tags": ["more"] },
      "expected": { "id": "x.rule", "tags": ["more"] }
    },
    {
      "name": "a list onto an object is a type mismatch",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"] } },
      "fields": { "references": ["https://learn.microsoft.com/a"] },
      "error": true
    },
    {
      "name": "a list onto a string is a type mismatch",
      "rule": { "id": "x.rule", "title": "Upstream title" },
      "fields": { "title": ["Custom title"] },
      "error": true
    },
    {
      "name": "an object onto a list is a type mismatch",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "first": "b" } },
      "error": true
    },
    {
      "name": "an object onto a string is a type mismatch",
      "rule": { "id": "x.rule", "discussion": "Upstream." },
      "fields": { "discussion": { "text": "Custom." } },
      "error": true
    },
    {
      "name": "an object onto null merges as onto an absent field",
      "rule": { "id": "asd_ism.ism-1622", "check": null },
      "fields": { "check": { "default": { "shell": "echo check", "result": null, "additional_info": null }, "by_version": {} } },
      "expected": {
        "id": "asd_ism.ism-1622",
        "check": { "default": { "shell": "echo check", "result": null, "additional_info": null }, "by_version": {} }
      }
    },
    {
      "name": "$merge onto null merges as onto an absent field",
      "rule": { "id": "x.rule", "odv": null },
      "fields": { "odv": { "$merge": { "recommended": 5 } } },
      "expected": { "id": "x.rule", "odv": { "recommended": 5 } }
    },
    {
      "name": "an object merges into a nested null",
      "rule": {
        "id": "x.rule",
        "check": { "default": null, "by_version": {} },
        "remediation": { "default": { "shell": null, "additional_info": null }, "mobileconfig_info": null }
      },
      "fields": {
        "check": { "default": { "shell": "echo check", "result": null, "additional_info": null } },
        "remediation": { "mobileconfig_info": { "com.apple.example": { "Key": true } } }
      },
      "expected": {
        "id": "x.rule",
        "check": { "default": { "shell": "echo check", "result": null, "additional_info": null }, "by_version": {} },
        "remediation": {
          "default": { "shell": null, "additional_info": null },
          "mobileconfig_info": { "com.apple.example": { "Key": true } }
        }
      }
    },
    {
      "name": "$merge onto a list is a type mismatch",
      "rule": { "id": "x.rule", "tags": ["a"] },
      "fields": { "tags": { "$merge": { "first": "b" } } },
      "error": true
    },
    {
      "name": "a nested type mismatch is invalid",
      "rule": { "id": "x.rule", "references": { "nist": ["AC-1"] } },
      "fields": { "references": { "nist": { "800-53r5": ["AC-2"] } } },
      "error": true
    },
    {
      "name": "the protected field id cannot be overlaid",
      "rule": { "id": "x.rule" },
      "fields": { "id": "x.other" },
      "error": true
    },
    {
      "name": "the protected field source cannot be overlaid",
      "rule": { "id": "x.rule", "source": { "release_tag": "v1" } },
      "fields": { "source": { "release_tag": "v2" } },
      "error": true
    },
    {
      "name": "the protected field file cannot be overlaid",
      "rule": { "id": "x.rule", "file": "rules/rule.json" },
      "fields": { "file": "rules/other.json" },
      "error": true
    },
    {
      "name": "the protected field schema_version cannot be overlaid",
      "rule": { "id": "x.rule", "schema_version": 4 },
      "fields": { "schema_version": 5 },
      "error": true
    },
    {
      "name": "a __proto__ field is invalid",
      "rule": { "id": "x.rule" },
      "fields": { "__proto__": { "polluted": true } },
      "error": true
    },
    {
      "name": "a nested __proto__ key is invalid",
      "rule": { "id": "x.rule", "references": {} },
      "fields": { "references": { "nist": { "__proto__": { "polluted": true } } } },
      "error": true
    },
    {
      "name": "a constructor key inside a $replace value is invalid",
      "rule": { "id": "x.rule", "references": {} },
      "fields": { "references": { "$replace": { "constructor": { "prototype": {} } } } },
      "error": true
    },
    {
      "name": "a prototype key inside an appended entry is invalid",
      "rule": { "id": "x.rule", "applicability": [] },
      "fields": { "applicability": [{ "prototype": 1 }] },
      "error": true
    },
    {
      "name": "a protected field is invalid even outside known_fields",
      "rule": { "id": "x.rule", "title": "Upstream title" },
      "fields": { "title": "Custom title", "file": "rules/other.json" },
      "known_fields": ["title"],
      "error": true
    }
  ],
  "index_cases": [
    {
      "name": "title, tags and assessment apply to an index entry",
      "entry": {
        "id": "asd_ism.ism-1622",
        "title": "Upstream title",
        "file": "rules/ism-1622.json",
        "section": "Guidelines for system hardening",
        "section_path": ["Guidelines for system hardening", "PowerShell"],
        "assessment": { "status": "manual", "manual_reason": "no_check" },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": {
        "title": "Custom title",
        "tags": ["powershell"],
        "assessment": { "manual_reason": "manual" },
        "discussion": { "$replace": "Not carried by an index entry." },
        "check": { "$replace": { "default": null, "by_version": {} } }
      },
      "expected": {
        "id": "asd_ism.ism-1622",
        "title": "Custom title",
        "file": "rules/ism-1622.json",
        "section": "Guidelines for system hardening",
        "section_path": ["Guidelines for system hardening", "PowerShell"],
        "assessment": { "status": "manual", "manual_reason": "manual" },
        "architecture": null,
        "applicability": [],
        "tags": ["powershell"],
        "has_odv": false
      }
    },
    {
      "name": "section follows an overlaid section_path",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "old",
        "section_path": ["old"],
        "assessment": { "status": "manual", "manual_reason": "manual" },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": { "section_path": { "$replace": ["new", "child"] } },
      "expected": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "new",
        "section_path": ["new", "child"],
        "assessment": { "status": "manual", "manual_reason": "manual" },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      }
    },
    {
      "name": "an odv set by $replace turns has_odv on",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "manual", "manual_reason": "manual" },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": {
        "odv": { "$replace": { "datatype": "number", "description": "Value", "validation": null, "recommended": 5, "by_benchmark": {} } }
      },
      "expected": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "manual", "manual_reason": "manual" },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": true
      }
    },
    {
      "name": "an odv set to null turns has_odv off",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": true
      },
      "fields": { "odv": null },
      "expected": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      }
    },
    {
      "name": "a partial odv merge keeps has_odv on when the rule has one",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": true
      },
      "fields": { "odv": { "recommended": 7 } },
      "expected": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": true
      }
    },
    {
      "name": "a partial odv onto a rule without one is invalid, since has_odv would promise a value",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": { "odv": { "recommended": 7 } },
      "error": true
    },
    {
      "name": "a complete odv object onto a rule without one turns has_odv on",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": { "odv": { "datatype": "number", "description": "Value", "validation": null, "recommended": 5, "by_benchmark": {} } },
      "expected": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": true
      }
    },
    {
      "name": "an overlay cannot set the derived index fields directly",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": { "section": "elsewhere", "has_odv": true },
      "expected": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      }
    },
    {
      "name": "a type mismatch on an index field is invalid",
      "entry": {
        "id": "x.rule",
        "title": "Rule",
        "file": "rules/rule.json",
        "section": "os",
        "section_path": ["os"],
        "assessment": { "status": "automated", "manual_reason": null },
        "architecture": null,
        "applicability": [],
        "tags": [],
        "has_odv": false
      },
      "fields": { "tags": { "$merge": { "a": 1 } } },
      "error": true
    }
  ]
}
